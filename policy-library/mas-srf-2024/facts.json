{
  "$schema_note": "The fact vocabulary the SRF register evaluates against: one claim, its account, the scam, the FI's conduct, the Telco's conduct, the workflow. Every field declares its kind; `judgment` fields hold `affirmed | denied | not_assessed` and are the assessments of whoever recorded the claim, never inferred here. `read_by` is documentation of intent and is NOT a coverage list (see banxico-34-2010/facts.json `integrity` for why stored coverage lists were withdrawn); _phase0/reads-graph.mjs derives which paths the register actually reads.",
  "integrity": {
    "$note": "No stored coverage list. The population that varies every path is _corpus/space.mjs SRF_FIELDS, checked by _phase0/reads-graph.mjs against the register's fact reads."
  },
  "fields": [
    {
      "field": "account.holder_type",
      "domain": {
        "kind": "enum",
        "values": [
          "individual",
          "sole_proprietor",
          "corporate",
          "other"
        ]
      },
      "read_by": [
        "srf/2.1/protected-account/a/individuals"
      ],
      "note": "The SRF admits `individual` only (A1)."
    },
    {
      "field": "account.issuer_type",
