    "value": "Never inferred from 2.6(a) being met. See ambiguity A3."
   }
  },
  "34-2010/3.6/p7/firmeza": {
   "op": "decision_table",
   "$table_from": "clauses.json, the decision_table on this clause. build-register.mjs copies inputs, rows and the conformance subtable from there, so the table is not transcribed and cannot drift from the published one.",
   "inputs": [
    {
     "name": "deadline",
     "expr": {
      "op": "clause",
      "id": "34-2010/3.6/p4/deadline"
     }
    },
    {
     "name": "a2",
     "expr": {
      "op": "coalesce",
      "value": {
       "op": "resolution",
       "name": "A2_terminos_senalados"
      },
      "fallback": {
       "op": "const",
       "value": "(unresolved)"
      }
     }
    }
   ],
   "subtable_inputs": {
    "conformance_subtest": {
     "op": "conjunction_over_results",
     "undetermined_is": "undetermined",
     "results": {
      "op": "list",
      "items": [
       {
        "op": "eq",
        "left": {
         "op": "clause",
         "id": "34-2010/3.6/p4/floor"
        },
        "right": {
         "op": "const",
         "value": "floor_met"
        }
       },
       {
        "op": "eq",
        "left": {
         "op": "clause",
         "id": "34-2010/3.6/p4/signatory"
        },
        "right": {
         "op": "const",
         "value": "member"
        }
       },
       {
        "op": "remap_result_domain",
        "value": {
         "op": "clause",
         "id": "34-2010/3.6/p4/language"
        },
        "mapping": {
         "affirmed": {
          "op": "const",
          "value": true
         },
         "denied": {
          "op": "const",
          "value": false
         },
         "not_assessed": {
          "op": "const",
          "value": "undetermined"
         },
         "$unmapped": {
          "op": "const",
          "value": "undetermined"
         }
        }
       }
      ]
     }
    }
   }
  }
 }
}